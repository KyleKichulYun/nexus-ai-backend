generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 대화 세션 (채팅방 개념)
model ChatSession {
  id        String        @id @default(uuid())
  userId    String?       // (선택) 추후 회원가입 연동 시 사용
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[] // 1:N 관계 (한 세션에 여러 메시지)
}

// 개별 채팅 메시지 (질문과 AI 답변)
model ChatMessage {
  id            String      @id @default(uuid())
  sessionId     String
  session       ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role          String      // 'user' 또는 'assistant'
  content       String      // 메시지 내용
  createdAt     DateTime    @default(now())

  @@index([sessionId]) // 조회 성능을 위한 인덱스
}

model SystemMetric {
  key       String   @id // 'total_connections' 등을 키로 사용
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}